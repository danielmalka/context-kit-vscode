{
  "name": "context-kit",
  "displayName": "Context Kit",
  "description": "Standalone library and harness for agent skills, commands, and multi-provider project setup.",
  "version": "1.3.0",
  "publisher": "danielmalka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielmalka/context-kit-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/danielmalka/context-kit-vscode/issues"
  },
  "homepage": "https://github.com/danielmalka/context-kit-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "context-kit",
          "title": "Context Kit",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "context-kit": [
        {
          "id": "contextKit.catalog",
          "name": "Catalog",
          "contextualTitle": "Context Kit Catalog"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "contextKit.catalog",
        "contents": "No assets scanned yet.\n[Scan library](command:contextKit.scan)\n\nApply a harness to the open workspace:\n[Apply Harness](command:contextKit.applyHarness)\n\nDream tools:\n[Activity map](command:contextKit.openActivityMap) · [Coverage](command:contextKit.openCoverage) · [Launch pad](command:contextKit.launchPad) · [Orchestrator](command:contextKit.openOrchestrator)"
      }
    ],
    "commands": [
      {
        "command": "contextKit.scan",
        "title": "Context Kit: Scan Library"
      },
      {
        "command": "contextKit.refreshTree",
        "title": "Context Kit: Refresh Catalog",
        "icon": "$(refresh)"
      },
      {
        "command": "contextKit.openAsset",
        "title": "Context Kit: Open Asset"
      },
      {
        "command": "contextKit.newSkill",
        "title": "Context Kit: New Skill"
      },
      {
        "command": "contextKit.newCommand",
        "title": "Context Kit: New Command"
      },
      {
        "command": "contextKit.editDefaults",
        "title": "Context Kit: Edit Harness Defaults"
      },
      {
        "command": "contextKit.applyHarness",
        "title": "Context Kit: Apply Harness to Workspace"
      },
      {
        "command": "contextKit.showLibraryPath",
        "title": "Context Kit: Show Library Path"
      },
      {
        "command": "contextKit.reseedFromPackage",
        "title": "Context Kit: Reseed Library from Package (reset seed assets)"
      },
      {
        "command": "contextKit.updateLibrary",
        "title": "Context Kit: Update Library from Package Seed"
      },
      {
        "command": "contextKit.deployToRuntime",
        "title": "Context Kit: Deploy Skill to User Runtime"
      },
      {
        "command": "contextKit.newWorkflow",
        "title": "Context Kit: New Workflow (Grok Rhai stub)"
      },
      {
        "command": "contextKit.openActivityMap",
        "title": "Context Kit: Open Activity Map",
        "icon": "$(pulse)"
      },
      {
        "command": "contextKit.openCoverage",
        "title": "Context Kit: Open Coverage Map",
        "icon": "$(table)"
      },
      {
        "command": "contextKit.launchPad",
        "title": "Context Kit: Launch Pad (run command in terminal)",
        "icon": "$(play)"
      },
      {
        "command": "contextKit.openOrchestrator",
        "title": "Context Kit: Orchestrator (multi-CLI pipeline)",
        "icon": "$(type-hierarchy-sub)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "contextKit.refreshTree",
          "when": "view == contextKit.catalog",
          "group": "navigation@1"
        },
        {
          "command": "contextKit.openActivityMap",
          "when": "view == contextKit.catalog",
          "group": "navigation@2"
        },
        {
          "command": "contextKit.openCoverage",
          "when": "view == contextKit.catalog",
          "group": "navigation@3"
        },
        {
          "command": "contextKit.launchPad",
          "when": "view == contextKit.catalog",
          "group": "navigation@4"
        },
        {
          "command": "contextKit.openOrchestrator",
          "when": "view == contextKit.catalog",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "contextKit.openAsset",
          "when": "view == contextKit.catalog && viewItem == asset",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Context Kit",
      "properties": {
        "contextKit.kitPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a local context-kit clone (maintainer reseed / power-user)."
        },
        "contextKit.scanOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Scan the user library when the extension activates."
        },
        "contextKit.userSkillRoots": {
          "type": "object",
          "default": {},
          "description": "Optional overrides for user runtime skill roots (claude, grok, agents). Empty values fall back to ~/.claude/skills, ~/.grok/skills, ~/.agents/skills.",
          "properties": {
            "claude": {
              "type": "string"
            },
            "grok": {
              "type": "string"
            },
            "agents": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "sync-seed": "bash scripts/sync-seed-from-kit.sh",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "fmt": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check": "make check",
    "package": "npm run compile && node scripts/package-vsix.mjs",
    "package:reseed": "npm run sync-seed && npm run package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  }
}
